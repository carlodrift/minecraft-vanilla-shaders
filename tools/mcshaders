#!/usr/bin/env bash
# Runs the repository tools against an installed Minecraft version.
#   tools/mcshaders check [resource-pack-dir]
#   tools/mcshaders pipelines            (JSON lines, one per render pipeline)
# Environment: MC_VERSION (default 26.3), JAVA (default: java on PATH, must be 25+)
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
version="${MC_VERSION:-26.3}"
java="${JAVA:-java}"
cp="$(python3 -I "$here/classpath.py" "$version")"
flags=(--enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -cp "$cp")

cmd="${1:-}"
shift || true
# Absolute paths, then run from a scratch directory: the game's logging creates logs/ in the working directory.
args=()
for a in "$@"; do args+=("$(cd "$(dirname "$a")" && pwd)/$(basename "$a")"); done
set -- "${args[@]+"${args[@]}"}"
work="$(mktemp -d)"
cd "$work"

# The sources are written against 26.3. From 26.4 some classes moved package: adapt the imports.
src="$here/src"
jar="${cp##*:}"
if unzip -l "$jar" com/mojang/blaze3d/pipeline/RenderPipeline.class >/dev/null 2>&1; then
  mkdir -p "$work/src"
  for f in "$here"/src/*.java; do
    sed -e 's/com\.mojang\.renderpearl\.api\.pipeline\.RenderPipeline;/com.mojang.blaze3d.pipeline.RenderPipeline;/' \
        -e 's/com\.mojang\.renderpearl\.api\.vertex\./com.mojang.blaze3d.vertex./' \
        -e 's/com\.mojang\.renderpearl\.backend\.api\.SpvModule;/com.mojang.renderpearl.api.pipeline.SpvModule;/' \
        "$f" > "$work/src/$(basename "$f")"
  done
  src="$work/src"
fi

case "$cmd" in
  check) exec "$java" "${flags[@]}" "$src/Check.java" "$@" ;;
  pipelines) exec "$java" "${flags[@]}" "$src/DumpPipelines.java" "$@" ;;
  *) sed -n '2,5p' "$0" >&2; exit 2 ;;
esac
